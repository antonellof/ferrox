{
  "name": "frink-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Frink Studio \u2014 the web frontend embedded in frink-server.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
